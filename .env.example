ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
LOG_LEVEL=INFO

# Local dev only — enables /dev/token endpoint and HS256 validation
ENV=dev
JWT_SECRET=your-jwt-secret

# Optional in dev — uncomment to enforce x-api-key header locally
# API_KEY=your-api-key

# Production — Cognito RS256 validation (leave blank in dev)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# Agent layer tuning — all optional, defaults shown
# AGENT_MODEL_DEFAULT=claude-sonnet-4-6
# AGENT_MODEL_THINKING=claude-opus-4-7
# AGENT_MAX_STEPS=10
# AGENT_THINKING_BUDGET_TOKENS=8000
# SUBAGENT_MODEL=claude-haiku-4-5-20251001
# SUBAGENT_MAX_TOKENS=1024
# JUDGE_MODEL=claude-haiku-4-5-20251001
# JUDGE_MAX_TOKENS=256
# AUDIT_LOG_TABLE=pci-llm-gateway-audit

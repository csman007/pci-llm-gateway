ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
LOG_LEVEL=INFO

# Local dev only — enables /dev/token endpoint and HS256 validation
ENV=dev
JWT_SECRET=your-jwt-secret

# Optional in dev — uncomment to enforce x-api-key header locally
# API_KEY=your-api-key

# Production — Cognito RS256 validation (leave blank in dev)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# RAG / pgvector
POSTGRES_DSN=postgresql://gateway:gateway@localhost:5432/pci_gateway
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=5
# RAG_HYBRID=true                     # set false to use vector-only search
# RAG_RRF_K=60                        # RRF constant — higher = less rank emphasis
# QUERY_ANALYZER_MODEL=claude-haiku-4-5-20251001
# QUERY_ANALYZER_MAX_TOKENS=256
# GROUNDING_STRICT=false              # set true to append warnings on hallucinated citations
# CONTEXT_MAX_CHUNK_CHARS=2000
# RAG_MIN_SCORE=0.0                   # discard chunks below this retrieval score (0.0 = no filter)
# RAG_CONTEXT_BUDGET_CHARS=8000       # max total chars in context block (prevents prompt overflow)
# GROUNDING_VALIDATE=false            # set true to enable semantic claim support via embeddings
# GROUNDING_THRESHOLD=0.82            # cosine similarity floor for claim support (0.75 lenient, 0.88 strict)

# Agent layer tuning — all optional, defaults shown
# AGENT_MODEL_DEFAULT=claude-sonnet-4-6
# AGENT_MODEL_THINKING=claude-opus-4-7
# AGENT_MAX_STEPS=10
# AGENT_THINKING_BUDGET_TOKENS=8000
# SUBAGENT_MODEL=claude-haiku-4-5-20251001
# SUBAGENT_MAX_TOKENS=1024
# JUDGE_MODEL=claude-haiku-4-5-20251001
# JUDGE_MAX_TOKENS=256
# AUDIT_LOG_TABLE=pci-llm-gateway-audit

# Observability
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pci-llm-gateway

# Multi-tenancy (leave TENANTS_TABLE unset to disable multi-tenancy locally)
# TENANTS_TABLE=pci-llm-gateway-tenants
# TENANT_CACHE_TTL_SECS=60

# Concurrency & rate limiting (leave RATE_LIMIT_TABLE unset to disable rate limiting locally)
# RATE_LIMIT_TABLE=pci-llm-gateway-rate-limit
# RATE_LIMIT_INFERENCE_RPM=60
# RATE_LIMIT_RAG_RPM=20
# RATE_LIMIT_AGENT_RPM=30
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_FAILURE_WINDOW_SECS=60
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=30
